{
  "$meta": { "name": "CaloSnap Garden", "version": "1.1", "theme": "light", "note": "Semantic names so a dark theme can remap values later." },
  "color": {
    "bg": "#F8F5EE",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F3F0E7",
    "surfaceSegmented": "#ECE8DD",
    "line": "#E6E2D6",
    "lineSubtle": "#EFECE3",
    "borderControl": "#DDD8CB",
    "borderButton": "#D9D4C6",
    "primary": "#173D30",
    "onPrimary": "#F8F5EE",
    "accent": "#7FA07E",
    "accentTint": "#E6EDE0",
    "homeGradientTop": "#E9EEE0",
    "trackEmpty": "#EDEAE0",
    "arcEmpty": "#E9E6DB",
    "estimate": "#D9A24E",
    "estimateLight": "#F1D39F",
    "estimateTint": "#F6EBD6",
    "onEstimateTint": "#6B4B14",
    "assumedTint": "#EEEBE2",
    "text": "#202B25",
    "textMuted": "#55615A",
    "textSubtle": "#6B756E",
    "disabledBg": "#E9E6DB",
    "disabledText": "#8B938C",
    "danger": "#A3452F",
    "dangerTint": "#F6E3DC",
    "onDangerTint": "#7E3322",
    "camera": "#0F1A15",
    "cameraScrim": "rgba(15,26,21,0.5)",
    "onCamera": "#F8F5EE",
    "onCameraMuted": "#C9D4CC",
    "cameraGlass": "rgba(255,255,255,0.14)",
    "frameGuide": "rgba(232,184,109,0.85)"
  },
  "font": {
    "family": "Plus Jakarta Sans",
    "numeric": "tabular-nums",
    "scale": {
      "display":  { "size": 44, "weight": 800, "lineHeight": 1.0, "letterSpacing": -0.03 },
      "title1":   { "size": 28, "weight": 800, "lineHeight": 1.15, "letterSpacing": -0.02 },
      "title2":   { "size": 22, "weight": 700, "lineHeight": 1.2 },
      "heading":  { "size": 17, "weight": 700, "lineHeight": 1.3 },
      "body":     { "size": 15, "weight": 500, "lineHeight": 1.5 },
      "label":    { "size": 14, "weight": 700, "lineHeight": 1.3 },
      "caption":  { "size": 13, "weight": 500, "lineHeight": 1.5 },
      "small":    { "size": 12, "weight": 600, "lineHeight": 1.4 },
      "micro":    { "size": 11, "weight": 700, "lineHeight": 1.3 }
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "screenX": 20, "screenXForm": 24 },
  "radius": { "sm": 10, "control": 14, "md": 16, "tile": 18, "row": 20, "card": 24, "cardLarge": 28, "sheet": 28, "pill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(23,61,48,0.06)",
    "sheet": "0 -8px 32px rgba(23,61,48,0.12)",
    "scanButton": "0 6px 16px rgba(23,61,48,0.30)",
    "toast": "0 10px 30px rgba(15,26,21,0.25)",
    "segmentActive": "0 1px 3px rgba(0,0,0,0.12)"
  },
  "size": { "touchMin": 44, "buttonHeight": 56, "buttonHeightCompact": 52, "tabBarHeight": 86, "scanButton": 60, "shutter": 86, "macroBarHeight": 8 },
  "motion": {
    "fast": "150ms ease-out",
    "standard": "250ms cubic-bezier(0.2,0,0,1)",
    "sheet": "320ms cubic-bezier(0.2,0,0,1)",
    "totalsUpdate": "600ms cubic-bezier(0.2,0,0,1)",
    "precisionAutoAdvance": "300ms",
    "toastDuration": "6000ms"
  }
}
